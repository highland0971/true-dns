# true-dns systemd unit (Linux deployment).
#
# Install:
#   sudo cp deploy/truedns.service /etc/systemd/system/
#   sudo cp dist/truedns-linux-amd64 /usr/local/bin/truedns
#   sudo mkdir -p /etc/truedns
#   sudo cp config.example.toml /etc/truedns/config.toml   # edit as needed
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now truedns
#
# "truedns run" takes over the system DNS on start and restores it on stop
# (ExecStop below is a belt-and-braces safety net for crashes that skip the
# in-process restore).

[Unit]
Description=true-dns anti-pollution local DNS proxy
After=network-online.target systemd-resolved.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/truedns run --config /etc/truedns/config.toml --no-elevate
ExecStop=/usr/local/bin/truedns restore --no-elevate
Restart=on-failure
RestartSec=3
LimitNOFILE=65536

# Takeover needs to write system DNS configuration; keep the proxy itself
# otherwise confined.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/truedns /etc/systemd/resolved.conf.d /etc/resolv.conf

[Install]
WantedBy=multi-user.target
